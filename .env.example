# Copy this file to .env.local for local development.
# Never commit .env.local or put secrets in NEXT_PUBLIC_ variables.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Server-only key. Keep this secret; do not prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Optional: URL of your separately deployed Python ML API, e.g. https://your-ml-service.example.com
ML_API_URL=
ML_API_SECRET=

# Optional weather API key. If blank, the weather route uses Open-Meteo (no key required).
OPENWEATHER_API_KEY=
